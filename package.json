{
  "name": "video-context",
  "version": "0.1.0",
  "description": "Turn a video into context an AI agent can use: a local timestamped transcript (whisper.cpp), key frames (ffmpeg) and an MCP server to search and read them.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "video-context": "dist/cli.js",
    "video-context-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js dist/mcp.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "prepare": "pnpm build"
  },
  "keywords": [
    "mcp",
    "video",
    "transcript",
    "whisper",
    "ffmpeg",
    "claude",
    "agents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
