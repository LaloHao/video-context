{
  "name": "@lalohao/video-context",
  "version": "0.1.0",
  "description": "Turn a video into context an AI agent can use: a local timestamped transcript (whisper.cpp or mlx-whisper), key frames (ffmpeg) and an MCP server to search and read them.",
  "keywords": [
    "mcp",
    "video",
    "transcript",
    "whisper",
    "mlx",
    "ffmpeg",
    "claude",
    "agents"
  ],
  "license": "MIT",
  "author": "Eduardo V.",
  "homepage": "https://github.com/LaloHao/video-context#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaloHao/video-context.git"
  },
  "bugs": {
    "url": "https://github.com/LaloHao/video-context/issues"
  },
  "type": "module",
  "bin": {
    "video-context": "dist/cli.js",
    "video-context-mcp": "dist/mcp.js",
    "video-context-ui": "dist/ui.js"
  },
  "files": [
    "dist",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js dist/mcp.js dist/ui.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "prepare": "pnpm build",
    "ui": "pnpm build && node dist/ui.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
